{
	"name": "bimbelbeta",
	"private": true,
	"type": "module",
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"hono": "^4.13.16",
			"@orpc/server": "^1.16.1",
			"@orpc/openapi": "^1.16.1",
			"@orpc/arktype": "^1.16.1",
			"@orpc/experimental-ratelimit": "^1.16.1",
			"better-auth": "^1.7.16",
			"dotenv": "^17.4.2",
			"drizzle-orm": "^1.0.0-rc.5-ab785fc",
			"arktype": "^2.2.9",
			"typescript": "^7.0.2",
			"midtrans-client": "^1.4.3",
			"vite": "^8.3.5",
			"tsdown": "^0.23.4",
			"@orpc/client": "^1.16.1",
			"@orpc/contract": "^1.16.1"
		}
	},
	"scripts": {
		"lint": "biome check . && bun scripts/check-tsx-lines.ts",
		"lint:fix": "biome check --write .",
		"dev": "turbo dev",
		"start": "turbo start",
		"build": "turbo build",
		"build:packages": "turbo build --filter='./packages/*'",
		"dev:packages": "turbo dev --filter='./packages/*'",
		"check-types": "turbo check-types",
		"dev:native": "turbo -F native dev",
		"dev:web": "turbo -F web dev",
		"dev:server": "turbo -F server dev",
		"db:push": "turbo -F @bimbelbeta/db db:push",
		"db:studio": "turbo -F @bimbelbeta/db db:studio",
		"db:generate": "turbo -F @bimbelbeta/db db:generate",
		"db:migrate": "turbo -F @bimbelbeta/db db:migrate",
		"db:start": "turbo -F @bimbelbeta/db db:start",
		"db:watch": "turbo -F @bimbelbeta/db db:watch",
		"db:stop": "turbo -F @bimbelbeta/db db:stop",
		"db:down": "turbo -F @bimbelbeta/db db:down",
		"db:seed": "turbo -F @bimbelbeta/db db:seed",
		"db:reset": "turbo -F @bimbelbeta/db db:reset",
		"auth:generate": "turbo -F @bimbelbeta/auth auth:generate",
		"check:tsx-lines": "bun scripts/check-tsx-lines.ts"
	},
	"dependencies": {
		"dotenv": "^17.4.2",
		"typescript": "^7.0.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@types/bun": "^1.4.4",
		"shadcn": "^4.23.0",
		"turbo": "^2.11.10"
	},
	"packageManager": "bun@1.4.4"
}
