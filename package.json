{
	"name": "bimbelbeta",
	"private": true,
	"type": "module",
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"hono": "^4.12.10",
			"@orpc/server": "^1.13.13",
			"@orpc/openapi": "^1.13.13",
			"@orpc/arktype": "^1.13.13",
			"@orpc/experimental-ratelimit": "^1.13.13",
			"better-auth": "^1.4.16",
			"dotenv": "^17.2.2",
			"drizzle-orm": "^1.0.0-beta.17-67b1795",
			"drizzle-arktype": "0.1.3",
			"arktype": "^2.2.0",
			"typescript": "^5.9.3",
			"midtrans-client": "^1.4.3",
			"vite": "^8.0.3",
			"tsdown": "^0.21.7",
			"@orpc/client": "^1.13.13",
			"@orpc/contract": "^1.13.13"
		}
	},
	"scripts": {
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"dev": "turbo dev",
		"start": "turbo start",
		"build": "turbo build",
		"build:packages": "turbo build --filter='./packages/*'",
		"dev:packages": "turbo dev --filter='./packages/*'",
		"check-types": "turbo check-types",
		"dev:native": "turbo -F native dev",
		"dev:web": "turbo -F web dev",
		"dev:server": "turbo -F server dev",
		"db:push": "turbo -F @bimbelbeta/db db:push",
		"db:studio": "turbo -F @bimbelbeta/db db:studio",
		"db:generate": "turbo -F @bimbelbeta/db db:generate",
		"db:migrate": "turbo -F @bimbelbeta/db db:migrate",
		"db:start": "turbo -F @bimbelbeta/db db:start",
		"db:watch": "turbo -F @bimbelbeta/db db:watch",
		"db:stop": "turbo -F @bimbelbeta/db db:stop",
		"db:down": "turbo -F @bimbelbeta/db db:down",
		"db:seed": "turbo -F @bimbelbeta/db db:seed",
		"db:reset": "turbo -F @bimbelbeta/db db:reset",
		"auth:generate": "turbo -F @bimbelbeta/auth auth:generate"
	},
	"dependencies": {
		"dotenv": "^17.2.2",
		"typescript": "^5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.10",
		"@types/bun": "^1.3.11",
		"shadcn": "^4.0.6",
		"turbo": "^2.7.4"
	},
	"packageManager": "bun@1.3.2"
}
