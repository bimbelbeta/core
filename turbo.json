{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"globalDependencies": ["biome.json", "bunfig.toml", "scripts/**"],
	"remoteCache": {
		"enabled": true,
		"teamSlug": "bimbelbeta-production"
	},
	"tasks": {
		"build": {
			"dependsOn": ["^build", "lint", "test"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"env": ["VITE_SERVER_URL", "VITE_MIDTRANS_CLIENT_KEY", "VITE_PAYMENTS_ENABLED"],
			"outputs": ["dist/**", ".output/**"]
		},
		"lint": {
			"dependsOn": ["^lint"],
			"inputs": ["$TURBO_DEFAULT$", "../../**/*.tsx"]
		},
		"check-types": {
			"cache": true,
			"dependsOn": ["^check-types"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"start": {
			"cache": false,
			"persistent": true
		},
		"db:push": {
			"cache": false,
			"persistent": true
		},
		"db:studio": {
			"cache": false,
			"persistent": true
		},
		"db:migrate": {
			"cache": false,
			"persistent": true
		},
		"db:generate": {
			"cache": false,
			"persistent": true
		},
		"db:start": {
			"cache": false,
			"persistent": true
		},
		"db:stop": {
			"cache": false,
			"persistent": true
		},
		"db:watch": {
			"cache": false,
			"persistent": true
		},
		"db:down": {
			"cache": false,
			"persistent": true
		},
		"db:seed": {
			"cache": false,
			"persistent": true
		},
		"db:reset": {
			"cache": false,
			"persistent": true
		},
		"auth:generate": {
			"cache": false
		},
		"test": {
			"dependsOn": ["^build", "^test"],
			"inputs": ["$TURBO_DEFAULT$"]
		}
	}
}
