{
	"name": "server",
	"main": "src/index.ts",
	"type": "module",
	"scripts": {
		"build": "bun build --production --target=bun --minify --sourcemap ./src/index.ts ./src/cron.ts --outdir ./dist",
		"compile": "bun build --production --compile --minify --sourcemap --bytecode ./src/index.ts --outfile ./bin/server",
		"dev": "bun run --hot --port=3001 ./src/index.ts ",
		"start": "bun ./dist/index.js",
		"cron": "bun ./src/cron.ts",
		"check-types": "tsc --noEmit"
	},
	"dependencies": {
		"@better-upload/server": "^3.0.20",
		"@bimbelbeta/api": "workspace:*",
		"@bimbelbeta/auth": "workspace:*",
		"@bimbelbeta/db": "workspace:*",
		"@orpc/arktype": "catalog:",
		"@orpc/openapi": "catalog:",
		"@orpc/server": "catalog:",
		"@orpc/experimental-ratelimit": "catalog:",
		"arktype": "catalog:",
		"better-auth": "catalog:",
		"dotenv": "catalog:",
		"drizzle-orm": "catalog:",
		"hono": "catalog:"
	},
	"devDependencies": {
		"typescript": "catalog:",
		"tsdown": "catalog:",
		"@bimbelbeta/config": "workspace:*"
	}
}
