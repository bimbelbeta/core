{
	"name": "@bimbelbeta/contract",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./*": {
			"types": "./dist/*.d.mts",
			"default": "./dist/*.mjs"
		}
	},
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc --noEmit"
	},
	"devDependencies": {
		"@bimbelbeta/config": "workspace:*",
		"tsdown": "catalog:"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"@bimbelbeta/db": "workspace:*",
		"@orpc/contract": "catalog:",
		"arktype": "catalog:",
		"drizzle-arktype": "catalog:"
	}
}
